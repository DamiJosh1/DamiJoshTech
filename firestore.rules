rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    
    function isAdmin() {
      return isSignedIn() && request.auth.token.email_verified == true && request.auth.token.email == "damijosh12@gmail.com";
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['status', 'customerName', 'customerEmail', 'customerPhone', 'shippingAddress', 'totalAmount', 'items', 'paymentReference', 'createdAt', 'updatedAt']) &&
             data.keys().size() == 10 &&
             data.status is string && data.status.size() <= 20 &&
             data.customerName is string && data.customerName.size() <= 100 &&
             data.customerEmail is string && data.customerEmail.size() <= 100 &&
             data.customerPhone is string && data.customerPhone.size() <= 50 &&
             data.shippingAddress is string && data.shippingAddress.size() <= 500 &&
             data.totalAmount is number &&
             data.items is list && data.items.size() <= 50 &&
             data.paymentReference is string && data.paymentReference.size() <= 100 &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }
    
    function isValidOrderUpdate() {
      return incoming().updatedAt == request.time && incoming().createdAt == existing().createdAt &&
             incoming().status is string && incoming().status.size() <= 20;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'originalPrice', 'image', 'category', 'badge', 'cjSku', 'createdAt']) &&
             data.keys().size() == 8 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.price is number &&
             (data.originalPrice == null || data.originalPrice is number) &&
             data.image is string && data.image.size() <= 1000 &&
             data.category is string && data.category.size() <= 100 &&
             data.badge is string && data.badge.size() <= 100 &&
             data.cjSku is string && data.cjSku.size() <= 100 &&
             data.createdAt == request.time;
    }

    match /orders/{orderId} {
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      allow read: if isAdmin();
      allow update: if isValidId(orderId) && isAdmin() && isValidOrderUpdate() && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isValidId(productId) && isAdmin() && isValidProduct(incoming());
      allow update: if false;
      allow delete: if isValidId(productId) && isAdmin();
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isValidId(userId) && isSignedIn() && request.auth.uid == userId;
      allow update: if isValidId(userId) && isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }
  }
}
